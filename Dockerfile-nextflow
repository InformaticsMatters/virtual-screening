FROM debian:13.7
LABEL maintainer="Tim Dudgeon<tdudgeon@informaticsmatters.com>"
# Note:     When run by the Data Manager the uid and gid
#           will be set according to the Project we're running against.
#           Consequently we cannot know in advance the user or group id
#           for execution, and so we must ensure the code runs
#           as any user.

# Nextflow 26 needs Java 17 or later
RUN apt-get update &&\
 apt-get install -y --no-install-recommends\
 openjdk-21-jre-headless\
 ca-certificates\
 curl\
 procps\
 git &&\
 apt-get clean -y

ENV HOME=/code
WORKDIR ${HOME}

# Install nextflow. Releases are here: https://github.com/nextflow-io/nextflow/releases
# The -dist file is self-contained, so nothing is downloaded when it runs.
# Running it once creates its home (${HOME}/.nextflow), which is made
# writable below as Nextflow writes to it (e.g. its plugins directory)
# as the (unknown) user that runs the job.
RUN curl -Ls -o nextflow https://github.com/nextflow-io/nextflow/releases/download/v26.04.6/nextflow-26.04.6-dist && \
    chmod 755 nextflow && \
    mv nextflow /usr/local/bin/ && \
    nextflow -version

COPY src/*.nf ./
COPY src/moldb/*.nf ./moldb/

COPY src/nf-processes ./nf-processes

# Adjust permissions for RunAsAnyUser
RUN chmod 777 ${HOME} && chmod -R a+rwX ${HOME}/.nextflow
