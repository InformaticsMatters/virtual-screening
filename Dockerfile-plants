FROM informaticsmatters/plants:latest

ENV PYTHONUNBUFFERED=1

USER 0

# Debian 11 (bullseye) is now EOL and no longer served from the live
# deb.debian.org / security.debian.org mirrors. Switch to the
# snapshot.debian.org mirror that Debian's own image ships (commented
# out) as a fallback for this, and stop apt rejecting its now-expired
# Release file.
RUN sed -i -e 's|^# deb http://snapshot|deb http://snapshot|' \
           -e '/^deb http:\/\/\(deb\|security\)\.debian\.org/ s|^|# |' \
           /etc/apt/sources.list && \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/99snapshot

RUN apt-get update &&\
  apt-get -y install python3\
    python-is-python3\
    python3-jinja2\
    python3-pip\
    openbabel\
    python3-openbabel &&\
  apt-get clean

COPY src/pharmacophore.py /code/

RUN chmod a+x /code/*.py &&\
    pip install "im-data-manager-job-utilities>=1.4.0"
