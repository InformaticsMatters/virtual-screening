FROM informaticsmatters/vs-rdkit-base:3.0.0

# Note:     When run by the Data Manager the uid and gid
#           will be set according to the Project we're running against.
#           Consequently we cannot know in advance the user or group id
#           for execution, and so we must ensure the code runs
#           as any user.

# libxrender1, libxext6 and libexpat1 are needed by rdkit.Chem.Draw, which
# ODDT's RDKit toolkit imports. Without them ODDT finds no toolkit and
# oddt.toolkit is None.
RUN apt-get -y update &&\
  apt-get -y install libxrender1 libxext6 libexpat1 &&\
  apt-get clean

ENV PYTHONPATH=/code
ENV HOME=/code
WORKDIR ${HOME}

# ODDT's setup.py imports six, so it is built without build isolation
# (and setuptools must be installed, as Python 3.12 no longer bundles it).
# It is installed from a source archive rather than a git clone because, in a
# clone, its version comes from 'git describe' (e.g. 0.6-200-gbfbf9ea), which
# is not PEP 440 and is rejected by current setuptools.
RUN pip install setuptools wheel six &&\
  pip install "im-data-manager-job-utilities>=1.4.0"\
  "im-rdkit-utilities>=1.2.0" &&\
  pip install --no-build-isolation https://github.com/oddt/oddt/archive/refs/heads/master.tar.gz

COPY src/*.py ./